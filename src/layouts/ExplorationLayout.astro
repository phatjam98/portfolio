---
import PageLayout from './PageLayout.astro';
import { getCategory } from '../data/categories';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  tags: string[];
  publishDate?: Date;
}

const { title, subtitle, description, tags, publishDate } = Astro.props;
const visionCat = getCategory('vision');

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const imageURL = new URL('/og-image.png', Astro.site ?? Astro.url.origin).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: canonicalURL,
  image: imageURL,
  author: { '@type': 'Person', name: 'Travis Carter' },
  ...(publishDate && { datePublished: publishDate.toISOString() }),
  ...(publishDate && { dateModified: publishDate.toISOString() }),
};
---

<PageLayout title={`${title} | Travis Carter`} description={description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <bp-scroll-progress class="bp-scroll-progress"></bp-scroll-progress>

  <article class="bp-article">
    <header class="bp-article-hero">
      <div class="bp-mono bp-article-eyebrow">
        <span class="rule" aria-hidden="true"></span>
        EXPLORATION · IDEA IN PROGRESS
      </div>
      <h1 class="bp-syne bp-article-title">{title}</h1>
      <p class="bp-article-lede">{subtitle}</p>

      <div class="bp-cs-detail-meta-strip bp-mono">
        <span
          class="bp-cs-detail-cat"
          style={`color:${visionCat.color}; border-color:${visionCat.color};`}
        >
          EXPLORATION
        </span>
        {publishDate && (
          <time datetime={publishDate.toISOString()}>
            {publishDate.toISOString().slice(0, 7).replace('-', '.')}
          </time>
        )}
      </div>

      {tags.length > 0 && (
        <ul class="bp-article-tags">
          {tags.map((t) => <li class="bp-mono">{t}</li>)}
        </ul>
      )}
    </header>

    <div class="bp-prose bp-article-body">
      <slot />
    </div>
  </article>
</PageLayout>
