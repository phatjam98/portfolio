---
interface Props {
  motion?: 'rich' | 'off';
}
const { motion = 'rich' } = Astro.props;

const lanes = [
  { y: 60, label: 'EVENTS_IN', n: 1280 },
  { y: 110, label: 'RAW_TELEMETRY', n: 4920 },
  { y: 160, label: 'STATE_MUTATIONS', n: 712 },
  { y: 210, label: 'EXTERNAL_FEEDS', n: 156 },
];

const dots = motion === 'off' ? [] : [
  { lane: 0, dur: 2.6, offset: 0 },
  { lane: 0, dur: 2.6, offset: -1.3 },
  { lane: 1, dur: 1.8, offset: 0 },
  { lane: 1, dur: 1.8, offset: -0.6 },
  { lane: 1, dur: 1.8, offset: -1.2 },
  { lane: 2, dur: 3.4, offset: 0 },
  { lane: 3, dur: 5.0, offset: 0 },
];

const fmt = (n: number) => n.toLocaleString('en-US');
---

<div class="bp-hero-diagram bp-grid">
  <div class="bp-mono bp-hero-diagram-title">
    <span>FIG. 01 — INGESTION TOPOLOGY</span>
    <span>SCALE 1:1 · DRAFT</span>
    <span>SHEET 01/04</span>
  </div>

  <svg viewBox="0 0 800 320" preserveAspectRatio="xMidYMid meet" class="bp-hero-diagram-svg">
    <!-- Source column -->
    <g transform="translate(60,40)">
      <rect x="0" y="0" width="140" height="240" fill="none" stroke="var(--bp-line)" stroke-dasharray="2 4" />
      <text x="70" y="-8" text-anchor="middle" fill="var(--bp-muted)" font-family="JetBrains Mono" font-size="9" letter-spacing="0.15em">SOURCES</text>
      {lanes.map((l, i) => (
        <g transform={`translate(0,${20 + i * 50})`}>
          <rect x="0" y="0" width="140" height="32" fill="var(--bp-surface)" stroke="var(--bp-line)" />
          <text x="10" y="13" fill="var(--bp-text)" font-family="JetBrains Mono" font-size="9" letter-spacing="0.1em">{l.label}</text>
          <text x="10" y="25" fill="var(--bp-accent)" font-family="JetBrains Mono" font-size="9" class="bp-num">{fmt(l.n)}/s</text>
          <circle
            cx="132" cy="16" r="3" fill="var(--bp-accent)"
            style={motion !== 'off' ? `animation: bp-pulse-dot ${1 + i * 0.3}s ease-in-out infinite;` : ''}
          />
        </g>
      ))}
    </g>

    <!-- Kafka column -->
    <g transform="translate(310,80)">
      <rect x="0" y="0" width="120" height="160" fill="var(--bp-surface)" stroke="var(--bp-accent)" stroke-width="1" />
      <text x="60" y="-10" text-anchor="middle" fill="var(--bp-accent)" font-family="JetBrains Mono" font-size="9" letter-spacing="0.15em">KAFKA</text>
      <text x="60" y="20" text-anchor="middle" fill="var(--bp-text)" font-family="Syne" font-weight="700" font-size="14">TOPICS</text>
      {[0, 1, 2, 3, 4].map((i) => (
        <line x1="14" y1={42 + i * 22} x2="106" y2={42 + i * 22} stroke="var(--bp-line)" stroke-dasharray="3 3" />
      ))}
      <text x="60" y="148" text-anchor="middle" fill="var(--bp-muted)" font-family="JetBrains Mono" font-size="8">PARTITIONS · 64</text>
    </g>

    <!-- Flink processing -->
    <g transform="translate(510,80)">
      <rect x="0" y="0" width="120" height="160" fill="var(--bp-surface)" stroke="var(--bp-line)" />
      <text x="60" y="-10" text-anchor="middle" fill="var(--bp-muted)" font-family="JetBrains Mono" font-size="9" letter-spacing="0.15em">FLINK</text>
      <text x="60" y="22" text-anchor="middle" fill="var(--bp-text)" font-family="Syne" font-weight="700" font-size="13">DETECT</text>
      {[28, 44, 36, 60, 52, 38, 70, 48, 30].map((h, i) => (
        <rect x={10 + i * 12} y={150 - h} width="8" height={h} fill={i === 6 ? 'var(--bp-accent)' : 'var(--bp-line)'} />
      ))}
      <text x="60" y="148" text-anchor="middle" fill="var(--bp-soft)" font-family="JetBrains Mono" font-size="8">9 OPERATORS</text>
    </g>

    <!-- Alert column -->
    <g transform="translate(700,90)">
      <rect x="0" y="0" width="60" height="60" fill="var(--bp-surface)" stroke="var(--bp-accent)" />
      <text x="30" y="34" text-anchor="middle" fill="var(--bp-accent)" font-family="Syne" font-weight="700" font-size="11">ALERT</text>
      <rect x="0" y="80" width="60" height="60" fill="var(--bp-surface)" stroke="var(--bp-line)" />
      <text x="30" y="114" text-anchor="middle" fill="var(--bp-muted)" font-family="Syne" font-weight="700" font-size="11">REMED</text>
    </g>

    <!-- Connectors from sources to Kafka -->
    {lanes.map((l, i) => (
      <path
        d={`M 200 ${l.y + 16} C 240 ${l.y + 16}, 270 ${140 + (i - 1.5) * 14}, 310 ${140 + (i - 1.5) * 14}`}
        stroke="var(--bp-line)" stroke-width="1" fill="none" stroke-dasharray="2 3"
      />
    ))}

    <!-- Connectors from Kafka to Flink -->
    {[0, 1, 2, 3, 4].map((i) => (
      <path
        d={`M 430 ${122 + i * 22} L 510 ${100 + i * 14}`}
        stroke="var(--bp-line)" stroke-width="1" fill="none"
      />
    ))}

    <!-- Flink to Alert (active path) -->
    <path
      d="M 630 130 L 700 120"
      stroke="var(--bp-accent)" stroke-width="1.5" fill="none" stroke-dasharray="6 3"
      style={motion !== 'off' ? 'animation: bp-flow 2s linear infinite;' : ''}
    />
    <!-- Flink to Remed (inactive) -->
    <path d="M 630 170 L 700 180" stroke="var(--bp-line)" stroke-width="1" fill="none" stroke-dasharray="6 3" />

    <!-- Travelling dots -->
    {dots.map((d) => (
      <circle r="2.5" fill="var(--bp-accent)">
        <animateMotion
          dur={`${d.dur}s`}
          repeatCount="indefinite"
          begin={`${d.offset}s`}
          path={`M 200 ${lanes[d.lane].y + 16} C 240 ${lanes[d.lane].y + 16}, 270 ${140 + (d.lane - 1.5) * 14}, 310 ${140 + (d.lane - 1.5) * 14} L 410 ${140 + (d.lane - 1.5) * 14} L 510 ${100 + d.lane * 14} L 630 130 L 700 120`}
        />
      </circle>
    ))}
  </svg>

  <div class="bp-mono bp-hero-diagram-legend">
    <span>● LIVE · <bp-count-up to="7068" class="bp-num"></bp-count-up> EVENTS/SEC</span>
    <span class="accent">P99 LATENCY <bp-count-up to="84" suffix="ms" class="bp-num"></bp-count-up></span>
    <span>UPTIME 99.97% · 28D</span>
  </div>
</div>
