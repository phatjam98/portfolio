---
import { getCategory, type CategoryId } from '../data/categories';

interface Props {
  slug: string;
  n: string;
  title: string;
  description: string;
  category: CategoryId;
  tags: string[];
  heroMetric?: string;
  heroMetricLabel?: string;
  variant?: number;
}

const {
  slug,
  n,
  title,
  description,
  category,
  tags,
  heroMetric,
  heroMetricLabel,
  variant = 0,
} = Astro.props;

const cat = getCategory(category);
const traceVariant = ((variant % 3) + 3) % 3;
---

<a href={`/case-studies/${slug}`} class="bp-card bp-cs-card">
  <bp-reveal-trace variant={String(traceVariant)}></bp-reveal-trace>

  <div class="bp-cs-card-meta bp-mono">
    <span>CS-{n}</span>
    <span class="cat" style={`color:${cat.color}; border-color:${cat.color};`}>
      {cat.label.toUpperCase()}
    </span>
  </div>

  {heroMetric && (
    <>
      <div class="bp-syne bp-num bp-cs-card-metric">{heroMetric}</div>
      {heroMetricLabel && (
        <div class="bp-mono bp-cs-card-metric-label">{heroMetricLabel.toUpperCase()}</div>
      )}
    </>
  )}

  <h3 class="bp-syne bp-cs-card-title">{title}</h3>
  <p class="bp-cs-card-desc">{description}</p>

  <ul class="bp-cs-card-tags">
    {tags.slice(0, 3).map((t) => (
      <li class="bp-mono">{t}</li>
    ))}
  </ul>
</a>
