---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { nowReading } from '../../data/now-reading';

const articles = (await getCollection('writing'))
  .filter((entry) => entry.data.status === 'published' || import.meta.env.DEV)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
---

<PageLayout
  title="Writing | Travis Carter"
  description="Technical articles on distributed systems, software architecture, and the tools that help us build better software."
>
  <section class="bp-section">
    <header class="bp-writing-head">
      <div class="bp-mono bp-section-tag">SHEET 04 — FIELD NOTES</div>
      <h1 class="bp-syne bp-writing-title">Writing</h1>
      <p class="bp-writing-lede">
        Technical articles and thoughts on distributed systems, software
        architecture, and the tools that help us build better software.
      </p>
    </header>

    <div class="bp-writing-body">
      <div class="bp-writing-list">
        {articles.length > 0 ? (
          articles.map((article) => (
            <a href={`/writing/${article.id}`} class="bp-writing-row">
              <div class="bp-mono bp-writing-row-meta">
                <time datetime={article.data.publishDate.toISOString()}>
                  {fmtDate(article.data.publishDate)}
                </time>
                {article.data.tags[0] && <span>· {article.data.tags[0]}</span>}
                {article.data.category && <span>· {article.data.category}</span>}
              </div>
              <h2 class="bp-syne bp-writing-row-title">{article.data.title}</h2>
              <p class="bp-writing-row-desc">{article.data.description}</p>
              <div class="bp-mono bp-writing-row-tags">
                {article.data.tags.slice(0, 3).map((t) => (
                  <span>{t}</span>
                ))}
              </div>
            </a>
          ))
        ) : (
          <p class="bp-cs-empty bp-mono">FIELD NOTES COMING SOON.</p>
        )}
      </div>

      <aside class="bp-writing-sidebar">
        <bp-now-reading
          title={nowReading.title}
          author={nowReading.author}
          chapter={String(nowReading.chapter)}
          of={String(nowReading.of)}
        ></bp-now-reading>

        <div class="bp-writing-sub-card">
          <div class="bp-mono bp-writing-sub-label">SUBSCRIBE</div>
          <p>Field notes delivered as they ship.</p>
          <a class="bp-link bp-mono" href="/rss.xml">RSS FEED →</a>
        </div>
      </aside>
    </div>
  </section>
</PageLayout>
