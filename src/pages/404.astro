---
import PageLayout from '../layouts/PageLayout.astro';
import RedactedDiagram from '../components/RedactedDiagram.astro';
---

<PageLayout
  title="404 — Page Not Found | Travis Carter"
  description="The page you're looking for doesn't exist."
>
  <section class="bp-404">
    <div class="bp-404-text">
      <div class="bp-mono bp-404-eyebrow">
        <span class="rule" aria-hidden="true"></span>
        ERR · DOC NOT FOUND
      </div>
      <h1 class="bp-syne bp-num bp-404-code">
        <bp-glitch>404</bp-glitch>
      </h1>
      <p class="bp-404-lede">
        Path unresolved. The page you're looking for doesn't exist; it may
        have been moved, renamed, or never existed in the first place.
      </p>
      <div class="bp-404-ctas">
        <a class="bp-cta" href="/">Back to Index <span aria-hidden="true">→</span></a>
        <a class="bp-cta-ghost" href="/case-studies">Browse Case Studies</a>
      </div>
    </div>

    <div class="bp-404-frame">
      <span class="bp-corner-mark top-left" aria-hidden="true"></span>
      <span class="bp-corner-mark top-right" aria-hidden="true"></span>
      <span class="bp-corner-mark bottom-left" aria-hidden="true"></span>
      <span class="bp-corner-mark bottom-right" aria-hidden="true"></span>
      <RedactedDiagram />
    </div>
  </section>
</PageLayout>
