---
import PageLayout from '../layouts/PageLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('case-studies'))
  .filter((entry) => entry.data.status === 'published' || import.meta.env.DEV)
  .sort((a, b) => a.data.order - b.data.order);

const callouts = [
  { n: 'A', label: 'INGEST', style: 'left: 4%;' },
  { n: 'B', label: 'PROCESS', style: 'left: 35%;' },
  { n: 'C', label: 'DETECT', style: 'left: 62%;' },
  { n: 'D', label: 'RESPOND', style: 'right: 4%;' },
];
---

<PageLayout title="Travis Carter | Software Architect" description="Portfolio of Travis Carter, a distributed systems engineer building event-driven architectures, real-time platforms, and developer tooling. Case studies in CI/CD optimization, EKS migrations, and streaming data engines.">
  <!-- Hero Section -->
  <section class="bp-hero">
    <aside class="bp-hero-margin bp-mono" aria-hidden="true">
      <span>§01</span>
      <span>§02</span>
      <span>§03</span>
      <span>§04</span>
    </aside>

    <div class="bp-hero-text">
      <div class="bp-mono bp-hero-eyebrow">
        <span class="rule" aria-hidden="true"></span>
        SOFTWARE ARCHITECT · DRAWING NO. 0001
      </div>
      <h1 class="bp-syne bp-hero-headline">
        I architect <span class="accent">distributed systems</span> that hold up at <span class="bracket-3am">3&nbsp;AM</span>.
      </h1>
      <p class="bp-hero-lede">
        Two careers, one instinct: design for the load before you draw the details.
        I build event-driven architectures, real-time platforms, and the developer
        tooling that holds them together.
      </p>

      <div class="bp-hero-ctas">
        <a class="bp-cta" href="/case-studies">View Case Studies <span aria-hidden="true">→</span></a>
        <a class="bp-cta-ghost" href="/about">About</a>
      </div>

      <div class="bp-mono bp-hero-status">
        <span><span class="dot" aria-hidden="true">●</span> AVAILABLE Q3 '26</span>
        <span>SLC, UTAH · GMT−7</span>
        <span>OPEN TO STAFF / PRINCIPAL</span>
      </div>
    </div>

    <div class="bp-hero-frame">
      <span class="bp-corner-mark top-left" aria-hidden="true"></span>
      <span class="bp-corner-mark top-right" aria-hidden="true"></span>
      <span class="bp-corner-mark bottom-left" aria-hidden="true"></span>
      <span class="bp-corner-mark bottom-right" aria-hidden="true"></span>

      <div class="bp-hero-callouts bp-mono" aria-hidden="true">
        {callouts.map((c) => (
          <span class="callout" style={c.style}>
            <span class="badge">{c.n}</span>
            <span class="label">{c.label}</span>
          </span>
        ))}
      </div>

      <bp-crosshair class="bp-hero-crosshair">
        <HeroDiagram motion="rich" />
      </bp-crosshair>
    </div>
  </section>

  <!-- §02 — Load-bearing numbers -->
  <section class="bp-section bp-section-bordered">
    <div class="bp-section-head">
      <h2 class="bp-mono bp-section-tag">§02 — LOAD-BEARING NUMBERS</h2>
      <span class="bp-mono bp-section-source">SOURCE: PRODUCTION TELEMETRY · 2024–2026</span>
    </div>
    <div class="bp-metrics-grid">
      <div class="bp-metric">
        <div class="bp-mono bp-metric-no">01 / 03</div>
        <div class="bp-syne bp-num bp-metric-value">
          <span class="prefix">−</span>
          <bp-count-up to="83"></bp-count-up>
          <span class="unit">%</span>
        </div>
        <div class="bp-metric-label">Build time reduction</div>
        <p class="bp-metric-detail">47-minute pipeline → under 8 minutes via per-app change detection + JIB.</p>
        <svg class="bp-metric-mark" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M 1 9 L 17 9 M 9 1 L 9 17" stroke="var(--bp-line)" stroke-width="1" />
        </svg>
      </div>

      <div class="bp-metric">
        <div class="bp-mono bp-metric-no">02 / 03</div>
        <div class="bp-syne bp-num bp-metric-value">
          <bp-count-up to="100" suffix="+"></bp-count-up>
          <span class="unit">svcs</span>
        </div>
        <div class="bp-metric-label">Migrated, zero downtime</div>
        <p class="bp-metric-detail">EKS 1.32 + Karpenter v1, solo DevOps owner across a 7-person team.</p>
        <svg class="bp-metric-mark" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M 1 9 L 17 9 M 9 1 L 9 17" stroke="var(--bp-line)" stroke-width="1" />
        </svg>
      </div>

      <div class="bp-metric">
        <div class="bp-mono bp-metric-no">03 / 03</div>
        <div class="bp-syne bp-num bp-metric-value">
          <bp-count-up to="4"></bp-count-up>
          <span class="unit">industries</span>
        </div>
        <div class="bp-metric-label">One streaming engine</div>
        <p class="bp-metric-detail">EventHorizon, the pattern that crystallized after four companies of the same problem.</p>
        <svg class="bp-metric-mark" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M 1 9 L 17 9 M 9 1 L 9 17" stroke="var(--bp-line)" stroke-width="1" />
        </svg>
      </div>
    </div>
  </section>

  <!-- §03 — Field work (selected case studies) -->
  {caseStudies.length > 0 && (
    <section class="bp-section">
      <div class="bp-section-head bp-section-head-row">
        <div>
          <h2 class="bp-mono bp-section-tag">§03 — FIELD WORK</h2>
          <p class="bp-syne bp-section-title">Selected Case Studies</p>
        </div>
        <a class="bp-link bp-mono bp-section-cta" href="/case-studies">
          VIEW ALL — {String(caseStudies.length).padStart(2, '0')} →
        </a>
      </div>
      <div class="bp-cs-grid">
        {caseStudies.map((study, i) => (
          <CaseStudyCard
            slug={study.id}
            n={String(i + 1).padStart(2, '0')}
            title={study.data.title}
            description={study.data.description}
            category={study.data.category}
            tags={study.data.tags}
            heroMetric={study.data.heroMetric}
            heroMetricLabel={study.data.heroMetricLabel}
            variant={i}
          />
        ))}
      </div>
    </section>
  )}

  <!-- §04 — Discipline index -->
  <section class="bp-section bp-section-bordered">
    <div class="bp-mono bp-section-tag bp-section-tag-solo">§04 — DISCIPLINE INDEX</div>
    <div class="bp-disciplines">
      <a class="bp-discipline" href="/case-studies/cicd-optimization">
        <div class="bp-mono bp-discipline-no">D.10</div>
        <h4 class="bp-discipline-title">Performance Optimization</h4>
        <p class="bp-discipline-body">47-minute CI pipelines down to under 8. JIB + change detection + a structural untangle of 32 Gradle projects.</p>
      </a>
      <a class="bp-discipline" href="/case-studies/event-horizon">
        <div class="bp-mono bp-discipline-no">D.20</div>
        <h4 class="bp-discipline-title">System Architecture</h4>
        <p class="bp-discipline-body">Real-time anomaly detection on Flink + Kafka. Same backbone, four industries.</p>
      </a>
      <a class="bp-discipline" href="/case-studies/eks-migrations">
        <div class="bp-mono bp-discipline-no">D.30</div>
        <h4 class="bp-discipline-title">Cloud Infrastructure</h4>
        <p class="bp-discipline-body">EKS clusters upgraded to 1.32 across 100+ services. Solo, deadline pressure, zero downtime.</p>
      </a>
      <a class="bp-discipline" href="/explorations">
        <div class="bp-mono bp-discipline-no">D.40</div>
        <h4 class="bp-discipline-title">Explorations</h4>
        <p class="bp-discipline-body">Agent orchestration, shared context layers, the next layer of developer tooling.</p>
      </a>
    </div>
  </section>
</PageLayout>
