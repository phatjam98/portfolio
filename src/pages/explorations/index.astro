---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getCategory } from '../../data/categories';

const explorations = (await getCollection('explorations'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order);

const visionCat = getCategory('vision');
---

<PageLayout
  title="Explorations | Travis Carter"
  description="Concepts, experiments, and forward-looking ideas in AI orchestration, streaming systems, and developer tooling."
>
  <section class="bp-section">
    <header class="bp-writing-head">
      <div class="bp-mono bp-section-tag">SHEET 05 — EXPLORATIONS</div>
      <h1 class="bp-syne bp-writing-title">Explorations</h1>
      <p class="bp-writing-lede">
        Ideas I'm actively thinking through. Concepts and early-stage projects,
        not shipped work, but directions I'm heading.
      </p>
    </header>

    <div class="bp-cs-rows">
      {explorations.length > 0 ? (
        explorations.map((entry, i) => {
          const n = String(i + 1).padStart(2, '0');
          return (
            <a href={`/explorations/${entry.id}`} class="bp-row bp-cs-row">
              <div class="bp-mono bp-num bp-cs-row-n">{n}</div>
              <span
                class="bp-mono bp-cs-row-cat"
                style={`color:${visionCat.color}; border-color:${visionCat.color};`}
              >
                EXPLORATION
              </span>
              <div class="bp-cs-row-title">
                <h3 class="bp-syne">{entry.data.title}</h3>
                <p>{entry.data.subtitle}</p>
              </div>
              <ul class="bp-cs-row-tags">
                {entry.data.tags.slice(0, 4).map((t) => <li class="bp-mono">{t}</li>)}
              </ul>
              <div class="bp-cs-row-metric">
                <div class="bp-mono bp-cs-row-metric-label">
                  {(entry.data.category || 'IDEA').toUpperCase()}
                </div>
              </div>
              <span class="bp-mono bp-cs-row-arrow" aria-hidden="true">→</span>
            </a>
          );
        })
      ) : (
        <p class="bp-cs-empty bp-mono">EXPLORATIONS COMING SOON.</p>
      )}
    </div>
  </section>
</PageLayout>
